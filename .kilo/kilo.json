{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "trello": {
      "type": "remote",
      "url": "https://mcp.trello.com/v1"
    },
    "devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}